# syntax=docker/dockerfile:1
# telemetry-generator — SIMULATED Falco/Tetragon runtime feed (Brief R1) — port 8087
FROM golang:1.26 AS builder
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
    -o /out/telemetry-generator ./cmd/telemetry-generator

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /out/telemetry-generator /telemetry-generator
EXPOSE 8087
USER nonroot:nonroot
ENTRYPOINT ["/telemetry-generator"]
