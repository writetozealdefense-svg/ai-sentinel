# syntax=docker/dockerfile:1
# prompt-svc (Interface 3, orchestrator) — port 8082
FROM golang:1.26 AS builder
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
    -o /out/prompt-svc ./cmd/prompt-svc

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /out/prompt-svc /prompt-svc
EXPOSE 8082
USER nonroot:nonroot
ENTRYPOINT ["/prompt-svc"]
