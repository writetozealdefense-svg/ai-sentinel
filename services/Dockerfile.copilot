# syntax=docker/dockerfile:1
# copilot-svc (Phase 4 AI Security Copilot) — port 8086
FROM golang:1.26 AS builder
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
    -o /out/copilot-svc ./cmd/copilot-svc

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /out/copilot-svc /copilot-svc
EXPOSE 8086
USER nonroot:nonroot
ENTRYPOINT ["/copilot-svc"]
